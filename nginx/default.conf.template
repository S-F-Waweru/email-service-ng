# Served by the nginx image; ${API_*} values come from the environment
# (see Dockerfile). Everything else here is plain nginx config.

# Lets /api keep WebSocket upgrades working if the backend ever adds them.
map $http_upgrade $connection_upgrade {
  default upgrade;
  ''      close;
}

server {
  listen 80;
  listen [::]:80;
  server_name _;

  root /usr/share/nginx/html;
  index index.html;

  server_tokens off;
  client_max_body_size 1m;

  gzip on;
  gzip_comp_level 6;
  gzip_min_length 1024;
  gzip_vary on;
  gzip_proxied any;
  gzip_types text/plain text/css application/javascript application/json image/svg+xml font/woff2;

  # Container health check (Dockerfile HEALTHCHECK, load balancers).
  location = /healthz {
    access_log off;
    default_type text/plain;
    return 200 "ok\n";
  }

  # ---- Backend ------------------------------------------------------------
  # Same as the dev proxy (proxy.conf.json): /api/auth/login -> /auth/login.
  # Keeping the API on the same origin means no CORS setup is needed.
  location /api/ {
    proxy_pass ${API_UPSTREAM}/;
    proxy_http_version 1.1;

    proxy_set_header Host $host;
    # The backend trusts one proxy hop (trust proxy = 1) for rate limiting,
    # so pass the client address on.
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;

    proxy_connect_timeout 5s;
    proxy_read_timeout ${API_TIMEOUT};
    proxy_send_timeout ${API_TIMEOUT};

    # API responses (tokens, API keys) must never be cached by the browser.
    add_header Cache-Control "no-store" always;
    include /etc/nginx/snippets/security-headers.conf;
  }

  # ---- App ----------------------------------------------------------------
  # Hashed build files (main-AB12CD.js, styles-…css, chunk-…js) never change.
  location ~* "-[A-Z0-9]{8}\.(js|css)$" {
    expires 1y;
    add_header Cache-Control "public, max-age=31536000, immutable" always;
    include /etc/nginx/snippets/security-headers.conf;
    try_files $uri =404;
  }

  # Logos, fonts and other files from public/: cache, but revalidate daily.
  location ~* \.(svg|png|jpg|jpeg|webp|ico|woff2?)$ {
    add_header Cache-Control "public, max-age=86400" always;
    include /etc/nginx/snippets/security-headers.conf;
    try_files $uri =404;
  }

  # Angular routes (/requests, /admin/users…) all load index.html.
  # index.html itself is never cached, so a deploy is picked up immediately.
  location / {
    add_header Cache-Control "no-cache" always;
    include /etc/nginx/snippets/security-headers.conf;
    try_files $uri $uri/ /index.html;
  }
}
